# App
NODE_ENV=development
PORT=3002

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=ecomcod
DATABASE_PASSWORD=ecomcod_secret
DATABASE_NAME=ecomcod_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# Auth / OTP
OTP_SECRET=replace-with-a-long-random-string

# Auth session / CORS
SESSION_TTL_S=604800
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Google OAuth (leave empty to disable Google login)
# Authorized redirect URI: http://localhost:3002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3002/api/auth/callback/google

# Web app to send the browser back to after Google login
FRONTEND_URL=http://localhost:3000
